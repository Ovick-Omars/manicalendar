<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>manicalendar - Manajemen Aktifitas Madrasah</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            emerald: {
              50: '#f0fdf4',
              100: '#dcfce7',
              200: '#bbf7d0',
              300: '#86efac',
              400: '#4ade80',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
              800: '#166534',
              900: '#14532d',
              950: '#052e16',
            },
            islamic: {
              gold: '#D4AF37',
              dark: '#0B2B26',
              mint: '#235E52',
              light: '#F4F7F6',
              accent: '#E5A93B'
            }
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Google Fonts & FontAwesome Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- React 18, ReactDOM & Babel Standalone CDN -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .arabic-text {
      font-family: 'Amiri', serif;
    }
    /* Animasi gelombang audio saat diputar */
    .bar {
      width: 3px;
      height: 8px;
      background-color: #D4AF37;
      display: inline-block;
      margin: 0 1px;
      border-radius: 1px;
    }
    .playing .bar {
      animation: bounce 0.8s ease-in-out infinite alternate;
    }
    .playing .bar:nth-child(2) { animation-delay: 0.15s; }
    .playing .bar:nth-child(3) { animation-delay: 0.3s; }
    .playing .bar:nth-child(4) { animation-delay: 0.1s; }
    @keyframes bounce {
      0% { height: 4px; }
      100% { height: 18px; }
    }
  </style>
</head>
<body class="bg-[#F4F7F6] text-slate-800 dark:bg-stone-950 dark:text-stone-100 min-h-screen transition-colors duration-300">
  <div id="root"></div>

  <script type="text/babel" data-presets="react">
    const { useState, useEffect, useRef } = React;

    const QURAN_SURAHS = [
      { id: 1, name: "Al-Fatihah", arabic: "الفاتحة", totalAyahs: 7 },
      { id: 2, name: "Al-Baqarah", arabic: "البقرة", totalAyahs: 286 },
      { id: 3, name: "Ali 'Imran", arabic: "آل عمران", totalAyahs: 200 },
      { id: 36, name: "Yasin", arabic: "يس", totalAyahs: 83 },
      { id: 55, name: "Ar-Rahman", arabic: "الرحمن", totalAyahs: 78 },
      { id: 56, name: "Al-Waqi'ah", arabic: "الواقعة", totalAyahs: 96 },
      { id: 67, name: "Al-Mulk", arabic: "الملک", totalAyahs: 30 },
      { id: 112, name: "Al-Ikhlas", arabic: "الإخلاص", totalAyahs: 4 },
      { id: 113, name: "Al-Falaq", arabic: "الفلق", totalAyahs: 5 },
      { id: 114, name: "An-Nas", arabic: "الناس", totalAyahs: 6 }
    ];

    const QARI_LIST = [
      { id: "Alafasy_128kbps", name: "Mishary Rashid Alafasy", desc: "Suara jernih dan berirama tenang" },
      { id: "Ghamadi_40kbps", name: "Saad Al-Ghamdi", desc: "Tajwid tartil tegas dan jelas" },
      { id: "Abdul_Basit_Murattal_64kbps", name: "Abdul Basit", desc: "Klasik, murattal penuh penjiwaan" }
    ];

    function App() {
      // Autentikasi & Pengguna
      const [currentUser, setCurrentUser] = useState(() => {
        const saved = localStorage.getItem("curUser");
        return saved ? JSON.parse(saved) : null;
      });

      const [users, setUsers] = useState(() => {
        const saved = localStorage.getItem("regUsers");
        if (saved) return JSON.parse(saved);
        const defaultUsers = [
          { id: "u1", username: "admin", password: "123", role: "admin", fullName: "Ustadz Pembina Utama" },
          { id: "u2", username: "santri", password: "123", role: "santri", fullName: "Ahmad Santri" }
        ];
        localStorage.setItem("regUsers", JSON.stringify(defaultUsers));
        return defaultUsers;
      });

      const [activeTab, setActiveTab] = useState("beranda");
      const [loginUser, setLoginUser] = useState("");
      const [loginPass, setLoginPass] = useState("");
      const [showLoginPass, setShowLoginPass] = useState(false);
      
      const [regUser, setRegUser] = useState("");
      const [regPass, setRegPass] = useState("");
      const [regFullName, setRegFullName] = useState("");
      const [regRole, setRegRole] = useState("santri");
      const [showRegPass, setShowRegPass] = useState(false);
      const [isRegOpen, setIsRegOpen] = useState(false);

      const [authMsg, setAuthMsg] = useState({ text: "", type: "" });

      // State Aktifitas (Rencana Kerja Madrasah)
      const [kegiatan, setKegiatan] = useState(() => {
        const saved = localStorage.getItem("kegiatanList");
        return saved ? JSON.parse(saved) : [
          { id: "k1", title: "Ujian Tahfidz Semester Ganjil", start: "2026-06-20", end: "2026-06-25", pic: "u1", desc: "Evaluasi hafalan 5 juz terakhir.", status: "Belum Selesai" }
        ];
      });

      // State Pengumuman / Informasi
      const [announcements, setAnnouncements] = useState(() => {
        const saved = localStorage.getItem("annList");
        return saved ? JSON.parse(saved) : [
          { id: "a1", title: "Pengumuman Libur Semester", content: "Mulai tanggal 1 Juli, madrasah diliburkan untuk persiapan tahun ajaran baru.", date: "2026-06-15T12:00:00.000Z", image: null }
        ];
      });

      // API URL untuk Google Sheets
      const [apiUrl, setApiUrl] = useState(() => {
        return localStorage.getItem("gas_api_url") || "";
      });
      const [syncStatus, setSyncStatus] = useState("Belum Sinkron");

      // Form Modals Rencana Kerja
      const [isKegModalOpen, setIsKegModalOpen] = useState(false);
      const [kegFormType, setKegFormType] = useState("add"); // 'add' | 'edit'
      const [editingKegId, setEditingKegId] = useState(null);
      const [kegTitle, setKegTitle] = useState("");
      const [kegStart, setKegStart] = useState("");
      const [kegEnd, setKegEnd] = useState("");
      const [kegPic, setKegPic] = useState("");
      const [kegDesc, setKegDesc] = useState("");
      const [kegStatus, setKegStatus] = useState("Belum Selesai");

      // Form Modals Informasi
      const [isAnnModalOpen, setIsAnnModalOpen] = useState(false);
      const [annFormType, setAnnFormType] = useState("add"); // 'add' | 'edit'
      const [editingAnnId, setEditingAnnId] = useState(null);
      const [annTitle, setAnnTitle] = useState("");
      const [annContent, setAnnContent] = useState("");
      const [annImage, setAnnImage] = useState(null); // base64 string

      // State Al-Quran Audio Player
      const [selSurahId, setSelSurahId] = useState(1);
      const [selQari, setSelQari] = useState("Alafasy_128kbps");
      const [playMode, setPlayMode] = useState("full"); // 'full' | 'range'
      const [startAyah, setStartAyah] = useState(1);
      const [endAyah, setEndAyah] = useState(7);
      const [curAyah, setCurAyah] = useState(1);
      const [isPlaying, setIsPlaying] = useState(false);
      const [isLoadingAudio, setIsLoadingAudio] = useState(false);
      const [audioError, setAudioError] = useState("");

      const audioRef = useRef(new Audio());
      const stateRef = useRef({ isPlaying: false, curAyah: 1, startAyah: 1, endAyah: 7, playMode: 'full', selSurahId: 1, selQari: 'Alafasy_128kbps' });

      // Sinkronisasi local storage
      useEffect(() => { localStorage.setItem("kegiatanList", JSON.stringify(kegiatan)); }, [kegiatan]);
      useEffect(() => { localStorage.setItem("annList", JSON.stringify(announcements)); }, [announcements]);
      useEffect(() => { localStorage.setItem("regUsers", JSON.stringify(users)); }, [users]);
      useEffect(() => { localStorage.setItem("gas_api_url", apiUrl); }, [apiUrl]);

      // FUNGSI UTAMA PENANGANAN TANGGAL: Anti-Mundur 1 Hari
      const parseLocalDate = (dateStr) => {
        if (!dateStr) return null;
        const cleanStr = dateStr.toString().trim();
        if (/^\d{4}-\d{2}-\d{2}$/.test(cleanStr)) {
          const [y, m, d] = cleanStr.split('-').map(Number);
          return new Date(y, m - 1, d); // Menggunakan tanggal lokal presisi tinggi
        }
        return new Date(cleanStr);
      };

      const formatDateDisplay = (dateStr) => {
        if (!dateStr) return "-";
        const d = parseLocalDate(dateStr);
        if (!d || isNaN(d.getTime())) return dateStr;
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();
        return `${day}-${month}-${year}`;
      };

      const formatToInputDate = (dateStr) => {
        if (!dateStr) return "";
        const d = parseLocalDate(dateStr);
        if (!d || isNaN(d.getTime())) return dateStr;
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      };

      // Sinkronisasi Audio State
      useEffect(() => {
        const curSurah = QURAN_SURAHS.find(s => s.id === selSurahId) || QURAN_SURAHS[0];
        stateRef.current = { isPlaying, curAyah, startAyah, endAyah, playMode, selSurahId, selQari, totalAyahs: curSurah.totalAyahs };
      }, [isPlaying, curAyah, startAyah, endAyah, playMode, selSurahId, selQari]);

      // Menyetel Audio Source & Memutar Ayat
      const playSelectedAyah = (surahNum, ayahNum) => {
        setIsLoadingAudio(true);
        setAudioError("");
        audioRef.current.pause();

        const pad = (num) => String(num).padStart(3, '0');
        const reciter = stateRef.current.selQari;
        const url = `https://everyayah.com/data/${reciter}/${pad(surahNum)}${pad(ayahNum)}.mp3`;

        audioRef.current.src = url;
        audioRef.current.load();

        audioRef.current.play()
          .then(() => setIsLoadingAudio(false))
          .catch((err) => {
            console.error(err);
            setIsLoadingAudio(false);
            setAudioError(`Audio ayat ${ayahNum} gagal dimuat.`);
            if (stateRef.current.isPlaying) {
              setTimeout(() => handleNextAyah(), 2500);
            }
          });
      };

      // Efek Pengulangan Otomatis Saat Audio Selesai
      useEffect(() => {
        const audioObj = audioRef.current;
        const handleEnded = () => {
          const { isPlaying, playMode, selSurahId, curAyah, startAyah, endAyah, totalAyahs } = stateRef.current;
          if (!isPlaying) return;

          if (playMode === 'full') {
            if (curAyah < totalAyahs) {
              const next = curAyah + 1;
              setCurAyah(next);
              playSelectedAyah(selSurahId, next);
            } else {
              setCurAyah(1);
              playSelectedAyah(selSurahId, 1); // Infinite Repeat Loop Full Surat
            }
          } else {
            if (curAyah < endAyah) {
              const next = curAyah + 1;
              setCurAyah(next);
              playSelectedAyah(selSurahId, next);
            } else {
              setCurAyah(startAyah);
              playSelectedAyah(selSurahId, startAyah); // Infinite Repeat Loop Rentang Ayat
            }
          }
        };

        audioObj.addEventListener('ended', handleEnded);
        return () => audioObj.removeEventListener('ended', handleEnded);
      }, []);

      const startPlayback = () => {
        setIsPlaying(true);
        const initAyah = playMode === 'range' ? startAyah : 1;
        setCurAyah(initAyah);
        setTimeout(() => { playSelectedAyah(selSurahId, initAyah); }, 100);
      };

      const togglePlayPause = () => {
        if (isPlaying) {
          audioRef.current.pause();
          setIsPlaying(false);
        } else {
          setIsPlaying(true);
          setTimeout(() => { playSelectedAyah(selSurahId, curAyah); }, 100);
        }
      };

      const stopPlayback = () => {
        audioRef.current.pause();
        audioRef.current.currentTime = 0;
        setIsPlaying(false);
        setCurAyah(playMode === 'range' ? startAyah : 1);
        setIsLoadingAudio(false);
      };

      const handleNextAyah = () => {
        const { playMode, selSurahId, curAyah, startAyah, endAyah, totalAyahs } = stateRef.current;
        if (playMode === 'full') {
          const next = curAyah < totalAyahs ? curAyah + 1 : 1;
          setCurAyah(next);
          if (isPlaying) playSelectedAyah(selSurahId, next);
        } else {
          const next = curAyah < endAyah ? curAyah + 1 : startAyah;
          setCurAyah(next);
          if (isPlaying) playSelectedAyah(selSurahId, next);
        }
      };

      const handlePrevAyah = () => {
        const { playMode, selSurahId, curAyah, startAyah, endAyah, totalAyahs } = stateRef.current;
        if (playMode === 'full') {
          const prev = curAyah > 1 ? curAyah - 1 : totalAyahs;
          setCurAyah(prev);
          if (isPlaying) playSelectedAyah(selSurahId, prev);
        } else {
          const prev = curAyah > startAyah ? curAyah - 1 : endAyah;
          setCurAyah(prev);
          if (isPlaying) playSelectedAyah(selSurahId, prev);
        }
      };

      useEffect(() => {
        return () => { audioRef.current.pause(); };
      }, []);

      // Autentikasi Handler
      const handleLoginSubmit = (e) => {
        e.preventDefault();
        const found = users.find(u => u.username.toLowerCase() === loginUser.toLowerCase() && u.password === loginPass);
        if (found) {
          setCurrentUser(found);
          localStorage.setItem("curUser", JSON.stringify(found));
          setLoginUser(""); setLoginPass("");
          setAuthMsg({ text: "Berhasil masuk!", type: "success" });
        } else {
          setAuthMsg({ text: "Username atau Password salah!", type: "error" });
        }
      };

      const handleRegisterSubmit = (e) => {
        e.preventDefault();
        if (!regUser || !regPass || !regFullName) {
          setAuthMsg({ text: "Lengkapi semua data!", type: "error" });
          return;
        }
        if (users.some(u => u.username.toLowerCase() === regUser.toLowerCase())) {
          setAuthMsg({ text: "Username sudah digunakan!", type: "error" });
          return;
        }
        const newUser = { id: "u_" + Date.now(), username: regUser, password: regPass, role: regRole, fullName: regFullName };
        const updated = [...users, newUser];
        setUsers(updated);
        setAuthMsg({ text: "Registrasi berhasil, silakan login!", type: "success" });
        setIsRegOpen(false);
        setRegUser(""); setRegPass(""); setRegFullName("");
      };

      const handleLogout = () => {
        stopPlayback();
        setCurrentUser(null);
        localStorage.removeItem("curUser");
        setActiveTab("beranda");
      };

      // Handler Rencana Kerja / Kegiatan
      const openAddKegModal = () => {
        setKegFormType("add");
        setKegTitle("");
        setKegStart(formatToInputDate(new Date().toISOString().split('T')[0]));
        setKegEnd(formatToInputDate(new Date().toISOString().split('T')[0]));
        setKegPic(users.filter(u => u.role === "admin")[0]?.id || "");
        setKegDesc("");
        setKegStatus("Belum Selesai");
        setIsKegModalOpen(true);
      };

      const openEditKegModal = (k) => {
        setKegFormType("edit");
        setEditingKegId(k.id);
        setKegTitle(k.title);
        setKegStart(formatToInputDate(k.start));
        setKegEnd(formatToInputDate(k.end));
        setKegPic(k.pic || "");
        setKegDesc(k.desc || "");
        setKegStatus(k.status);
        setIsKegModalOpen(true);
      };

      const handleKegSubmit = (e) => {
        e.preventDefault();
        if (kegFormType === "add") {
          const newKeg = {
            id: "k_" + Date.now(),
            title: kegTitle,
            start: kegStart, 
            end: kegEnd,
            pic: kegPic,
            desc: kegDesc,
            status: kegStatus
          };
          setKegiatan([...kegiatan, newKeg]);
        } else {
          setKegiatan(kegiatan.map(k => k.id === editingKegId ? {
            ...k, title: kegTitle, start: kegStart, end: kegEnd, pic: kegPic, desc: kegDesc, status: kegStatus
          } : k));
        }
        setIsKegModalOpen(false);
      };

      const handleImgFileChange = (e) => {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onloadend = () => {
            setAnnImage(reader.result);
          };
          reader.readAsDataURL(file);
        }
      };

      // Handler Informasi / Pengumuman
      const openAddAnnModal = () => {
        setAnnFormType("add");
        setAnnTitle("");
        setAnnContent("");
        setAnnImage(null);
        setIsAnnModalOpen(true);
      };

      const openEditAnnModal = (a) => {
        setAnnFormType("edit");
        setEditingAnnId(a.id);
        setAnnTitle(a.title);
        setAnnContent(a.content);
        setAnnImage(a.image || null);
        setIsAnnModalOpen(true);
      };

      const handleAnnSubmit = (e) => {
        e.preventDefault();
        if (annFormType === "add") {
          const newAnn = {
            id: "a_" + Date.now(),
            title: annTitle,
            content: annContent,
            date: new Date().toISOString(),
            image: annImage
          };
          setAnnouncements([newAnn, ...announcements]);
        } else {
          setAnnouncements(announcements.map(a => a.id === editingAnnId ? {
            ...a, title: annTitle, content: annContent, image: annImage
          } : a));
        }
        setIsAnnModalOpen(false);
      };

      // Sinkronisasi ke Cloud via Google Sheets Apps Script API
      const handleCloudSync = async () => {
        if (!apiUrl) {
          alert("Silakan atur URL API Google Apps Script terlebih dahulu di tab Sistem!");
          return;
        }
        setSyncStatus("Menghubungkan...");
        try {
          // POST Kegiatan ke Backend
          for (let k of kegiatan) {
            await fetch(apiUrl, {
              method: "POST",
              mode: "no-cors",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                action: "saveTodo",
                id: k.id,
                task: k.title,
                subActivity: k.desc,
                pic: k.pic,
                startDate: k.start,
                endDate: k.end,
                progress: k.status === "Selesai" ? 100 : 0
              })
            });
          }
          setSyncStatus("Tersinkronisasi");
          alert("Sinkronisasi database awan berhasil!");
        } catch (error) {
          console.error(error);
          setSyncStatus("Gagal");
          alert("Gagal melakukan sinkronisasi database awan.");
        }
      };

      if (!currentUser) {
        return (
          <div className="min-h-screen bg-gradient-to-tr from-slate-900 via-emerald-950 to-slate-900 flex items-center justify-center p-4">
            <div className="w-full max-w-md bg-white dark:bg-stone-900 rounded-3xl shadow-2xl overflow-hidden border border-emerald-500/10">
              <div className="p-8 text-center bg-gradient-to-b from-emerald-800 to-emerald-950 text-white">
                <h1 className="text-2xl font-black tracking-wide">ManiCalendar</h1>
                <p className="text-emerald-300 text-xs mt-1">Sistem Kegiatan Madrasah & Al-Quran Player</p>
              </div>

              <div className="p-8 space-y-4">
                {authMsg.text && (
                  <div className={`p-3 rounded-xl text-xs font-semibold ${authMsg.type === "success" ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800"}`}>
                    {authMsg.text}
                  </div>
                )}

                {!isRegOpen ? (
                  <form onSubmit={handleLoginSubmit} className="space-y-4">
                    <div>
                      <label className="block text-[10px] font-extrabold uppercase tracking-widest text-slate-400 mb-1">Username</label>
                      <input
                        type="text"
                        required
                        value={loginUser}
                        onChange={(e) => setLoginUser(e.target.value)}
                        placeholder="admin / santri"
                        className="w-full px-4 py-2.5 border rounded-xl focus:ring-2 focus:ring-emerald-600 outline-none dark:bg-stone-850 dark:border-stone-800 dark:text-white"
                      />
                    </div>
                    <div>
                      <label className="block text-[10px] font-extrabold uppercase tracking-widest text-slate-400 mb-1">Password</label>
                      <div className="relative">
                        <input
                          type={showLoginPass ? "text" : "password"}
                          required
                          value={loginPass}
                          onChange={(e) => setLoginPass(e.target.value)}
                          placeholder="Masukkan password"
                          className="w-full px-4 py-2.5 border rounded-xl focus:ring-2 focus:ring-emerald-600 outline-none dark:bg-stone-850 dark:border-stone-800 dark:text-white"
                        />
                        <button
                          type="button"
                          onClick={() => setShowLoginPass(!showLoginPass)}
                          className="absolute right-3 top-3 text-slate-400"
                        >
                          <i className={`fa-solid ${showLoginPass ? 'fa-eye-slash' : 'fa-eye'}`}></i>
                        </button>
                      </div>
                    </div>
                    <button type="submit" className="w-full py-3 bg-emerald-700 hover:bg-emerald-600 text-white font-bold rounded-xl shadow-lg transition">
                      Masuk Sistem
                    </button>
                    <p className="text-center text-xs text-slate-500">
                      Pengguna baru? <button type="button" onClick={() => setIsRegOpen(true)} className="text-emerald-700 font-bold hover:underline">Registrasi disini</button>
                    </p>
                  </form>
                ) : (
                  <form onSubmit={handleRegisterSubmit} className="space-y-4">
                    <div>
                      <label className="block text-[10px] font-extrabold uppercase tracking-widest text-slate-400 mb-1">Nama Lengkap</label>
                      <input
                        type="text"
                        required
                        value={regFullName}
                        onChange={(e) => setRegFullName(e.target.value)}
                        placeholder="Nama Lengkap Anda"
                        className="w-full px-4 py-2.5 border rounded-xl focus:ring-2 focus:ring-emerald-600 outline-none"
                      />
                    </div>
                    <div>
                      <label className="block text-[10px] font-extrabold uppercase tracking-widest text-slate-400 mb-1">Username</label>
                      <input
                        type="text"
                        required
                        value={regUser}
                        onChange={(e) => setRegUser(e.target.value)}
                        placeholder="Pilih username"
                        className="w-full px-4 py-2.5 border rounded-xl focus:ring-2 focus:ring-emerald-600 outline-none"
                      />
                    </div>
                    <div>
                      <label className="block text-[10px] font-extrabold uppercase tracking-widest text-slate-400 mb-1">Password</label>
