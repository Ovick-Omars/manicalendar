                  <div className="pt-4 border-t flex items-center justify-end gap-3">
                    <button type="button" onClick={() => setIsKegModalOpen(false)} className="px-4 py-2 bg-slate-100 rounded-lg">Batal</button>
                    <button type="submit" className="px-5 py-2 bg-emerald-700 text-white font-bold rounded-lg">Simpan Data</button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* Modal Informasi / Pengumuman */}
          {isAnnModalOpen && (
            <div className="fixed inset-0 z-50 bg-slate-950/40 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden border">
                <div className="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
                  <h3 className="font-bold text-sm">
                    {annFormType === "add" ? "Buat Pengumuman Baru" : "Edit / Revisi Pengumuman"}
                  </h3>
                  <button onClick={() => setIsAnnModalOpen(false)} className="text-slate-400 hover:text-white">
                    <i className="fa-solid fa-xmark"></i>
                  </button>
                </div>

                <form onSubmit={handleAnnSubmit} className="p-6 space-y-4 text-xs text-slate-800">
                  <div>
                    <label className="block text-[10px] font-bold text-slate-500 uppercase mb-1">Judul Pengumuman</label>
                    <input
                      type="text"
                      required
                      value={annTitle}
                      onChange={(e) => setAnnTitle(e.target.value)}
                      placeholder="Masukkan judul pengumuman"
                      className="w-full px-3 py-2 border rounded-xl outline-none"
                    />
                  </div>

                  <div>
                    <label className="block text-[10px] font-bold text-slate-500 uppercase mb-1">Isi Detail</label>
                    <textarea
                      required
                      value={annContent}
                      onChange={(e) => setAnnContent(e.target.value)}
                      rows="5"
                      placeholder="Masukkan konten atau deskripsi..."
                      className="w-full px-3 py-2 border rounded-xl outline-none"
                    />
                  </div>

                  <div>
                    <label className="block text-[10px] font-bold text-slate-500 uppercase mb-1">Unggah Gambar (Opsional)</label>
                    <input
                      type="file"
                      accept="image/*"
                      onChange={handleImgFileChange}
                      className="w-full text-slate-400"
                    />
                    {annImage && (
                      <div className="mt-3 relative w-full max-h-40 overflow-hidden rounded-xl border">
                        <img src={annImage} alt="Preview" className="w-full h-full object-cover" />
                        <button
                          type="button"
                          onClick={() => setAnnImage(null)}
                          className="absolute top-2 right-2 p-1.5 bg-rose-600 text-white rounded-full text-[10px]"
                        >
                          <i className="fa-solid fa-trash"></i> Hapus Gambar
                        </button>
                      </div>
                    )}
                  </div>

                  <div className="pt-4 border-t flex items-center justify-end gap-3">
                    <button type="button" onClick={() => setIsAnnModalOpen(false)} className="px-4 py-2 bg-slate-100 rounded-lg">Batal</button>
                    <button type="submit" className="px-5 py-2 bg-emerald-700 text-white font-bold rounded-lg">Simpan</button>
                  </div>
                </form>
              </div>
            </div>
          )}

          <footer className="fixed bottom-0 left-0 right-0 py-2 bg-slate-900 text-slate-400 text-center text-[9px] tracking-widest font-semibold border-t border-slate-800 z-40">
            CREATED BY RAFLIANO &copy; 2026 - MANICALENDAR v2.5 STABLE
          </footer>
        </div>
      );
    }

    // MEMPERBAIKI ROOT INITIALIZATION AGAR TIDAK BLANK
    const container = document.getElementById('root');
    if (container) {
      const root = ReactDOM.createRoot(container);
      root.render(<App />);
    }
  </script>
</body>
</html>
