  <div id="root" class="flex-grow flex flex-col"></div>

  <!-- ✅ FIX #3: Gunakan type="module" — tidak perlu Babel, berjalan native di semua browser modern -->
  <script type="module">
    import { useState, useEffect, useRef, useCallback } from 'react';
    import { createRoot } from 'react-dom/client';
    // htm = JSX-like template literals, tidak perlu Babel build step
    import { html } from 'htm/react';

    // Sembunyikan loading screen
    document.getElementById('app-loading').style.display = 'none';

    // ─── KONSTANTA ───────────────────────────────────────────────
    const DEFAULT_GAS_URL = ''; // ✅ FIX #4: Dikosongkan — user wajib isi URL GAS-nya sendiri via Settings

    const FALLBACK_TODOS = [
      { id: '1', task: 'Ujian Tengah Semester Ganjil', subActivity: 'Persiapan lembar soal & pengawas madrasah', pic: 'admin', startDate: '2026-06-01', endDate: '2026-06-05', progress: 50, createdBy: 'admin', keterangan: 'Soal sedang dicetak.' },
      { id: '2', task: 'Rapat Kerja Tahunan Madrasah', subActivity: 'Penyusunan anggaran belanja sekolah', pic: 'rafliano', startDate: '2026-06-10', endDate: '2026-06-12', progress: 100, createdBy: 'admin', keterangan: 'Rapat berjalan lancar.' },
      { id: '3', task: 'Penerimaan Santri Baru (PSB)', subActivity: 'Seleksi berkas & wawancara online', pic: 'rafliano', startDate: '2026-06-15', endDate: '2026-06-20', progress: 20, createdBy: 'admin', keterangan: '' }
    ];
    const FALLBACK_INFOS = [
      { id: '1', title: 'Persiapan Ujian Semester', content: 'Diharapkan seluruh asatidzah mempersiapkan naskah soal ujian paling lambat akhir minggu ini.', timestamp: '2026-06-01T09:15:00.000Z', createdBy: 'rafliano' },
      { id: '2', title: 'Kebersihan Lingkungan Madrasah', content: 'Kerja bakti rutin hari Jumat akan difokuskan pada area halaman depan dan ruang kelas baru.', timestamp: '2026-06-01T10:30:00.000Z', createdBy: 'admin' }
    ];
    const QARI_LIST = [
      { name: 'Misyari Al-Afasy', id: 'ar.alafasy' },
      { name: 'Abdurrahman As-Sudais', id: 'ar.abdurrahmaansudais' },
      { name: 'Maher Al-Muaiqly', id: 'ar.mahermuaiqly' },
      { name: 'Ali Al-Hudhaify', id: 'ar.hudhaify' },
      { name: 'Mahmoud Khalil Al-Husary', id: 'ar.husary' },
      { name: 'Saad Al-Ghamdi', id: 'ar.saadalgamdi' },
      { name: 'Abdul Basit Abdul Samad', id: 'ar.abdulbasitmurattal' },
      { name: 'Mohamed Siddiq El-Minshawi', id: 'ar.minshawi' }
    ];
    const SHOLAT_TIMES = [
      { name: 'Subuh', time: '04:36', icon: 'fa-cloud-sun' },
      { name: 'Dzuhur', time: '11:53', icon: 'fa-sun' },
      { name: 'Ashar', time: '15:14', icon: 'fa-cloud' },
      { name: 'Maghrib', time: '17:48', icon: 'fa-moon' },
      { name: 'Isya', time: '19:01', icon: 'fa-star-and-crescent' }
    ];

    // ─── UTILITY FUNCTIONS ────────────────────────────────────────
    const parseLocalDate = (dateStr) => {
      if (!dateStr) return null;
      try {
        const s = dateStr.toString().trim();
        if (s.includes('T')) {
          const [y, m, d] = s.split('T')[0].split('-').map(Number);
          return new Date(y, m - 1, d);
        }
        const parts = s.split(/[-/]/);
        if (parts.length === 3) {
          if (parts[0].length === 4) return new Date(+parts[0], +parts[1]-1, +parts[2]);
          if (parts[2].length === 4) return new Date(+parts[2], +parts[1]-1, +parts[0]);
        }
        const d = new Date(s);
        if (!isNaN(d.getTime())) return d;
      } catch(e) {}
      return null;
    };
    const formatDateStr = (dateStr) => {
      if (!dateStr) return '';
      const d = parseLocalDate(dateStr);
      if (!d) return dateStr;
      return `${String(d.getDate()).padStart(2,'0')}-${String(d.getMonth()+1).padStart(2,'0')}-${d.getFullYear()}`;
    };
    const formatToInputDate = (dateStr) => {
      if (!dateStr) return '';
      const d = parseLocalDate(dateStr);
      if (!d) return dateStr;
      return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    };
    const formatTimestamp = (ts) => {
      if (!ts) return '';
      const d = new Date(ts.toString().trim());
      if (isNaN(d.getTime())) return ts;
      return `${String(d.getDate()).padStart(2,'0')}-${String(d.getMonth()+1).padStart(2,'0')}-${d.getFullYear()} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
    };
    const getHijriDate = () => {
      return new Intl.DateTimeFormat('id-ID-u-ca-islamic-umalqura', { calendar:'islamic-umalqura', day:'numeric', month:'long', year:'numeric' }).format(new Date());
    };
    const todayInputDate = () => new Date().toISOString().split('T')[0];
    const ls = {
      get: (k, fallback=null) => { try { const v=localStorage.getItem(k); return v ? JSON.parse(v) : fallback; } catch(e){ return fallback; }},
      set: (k,v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch(e){} },
      str: (k,fallback='') => localStorage.getItem(k) || fallback,
      setStr: (k,v) => localStorage.setItem(k,v),
      remove: (k) => localStorage.removeItem(k)
    };

    // ─── KOMPONEN UTAMA APP ────────────────────────────────────────
    function App() {
      const [apiUrl, setApiUrl]           = useState(() => ls.str('gas_api_url', DEFAULT_GAS_URL));
      const [apiConnected, setApiConnected] = useState(false);
      const [currentUser, setCurrentUser]   = useState(() => ls.get('active_user', null));
      const [currentTab, setCurrentTab]     = useState('home');
      const [theme, setTheme]               = useState(() => ls.str('theme', 'light'));
      const [users, setUsers]               = useState([]);
      const [todos, setTodos]               = useState([]);
      const [infos, setInfos]               = useState([]);
      const [syncing, setSyncing]           = useState(false);
      const [currentPage, setCurrentPage]   = useState(1);
      const rowsPerPage = 10;
      const [toast, setToast]               = useState({ show:false, message:'', type:'success' });
      const [confirmModal, setConfirmModal] = useState({ isOpen:false, message:'', action:null });
      const [isUrlModalOpen, setIsUrlModalOpen] = useState(false);
      const [customUrlInput, setCustomUrlInput] = useState('');
      const [showPassword, setShowPassword]   = useState(false);
      const [showRegPassword, setShowRegPassword] = useState(false);
      const [isRegisterMode, setIsRegisterMode] = useState(false);
      const [regForm, setRegForm]             = useState({ username:'', email:'', password:'' });
      const [loginForm, setLoginForm]         = useState({ username:'', password:'' });
      const [authError, setAuthError]         = useState('');
      const [authSuccess, setAuthSuccess]     = useState('');
      const [isModalOpen, setIsModalOpen]     = useState(false);
      const [activityForm, setActivityForm]   = useState({ id:'', task:'', subActivity:'', pic:'', startDate:'', endDate:'', progress:0, keterangan:'', createdBy:'' });
      const [isEditing, setIsEditing]         = useState(false);
      const [isInfoModalOpen, setIsInfoModalOpen] = useState(false);
      const [isEditingInfo, setIsEditingInfo]   = useState(false);
      const [infoForm, setInfoForm]             = useState({ id:'', title:'', content:'' });
      const [keteranganModal, setKeteranganModal] = useState({ isOpen:false, todo:null, text:'' });
      const [quranSurahs, setQuranSurahs]       = useState([]);
      const [selectedSurah, setSelectedSurah]   = useState(null);
      const [surahDetails, setSurahDetails]     = useState(null);
      const [loadingQuran, setLoadingQuran]     = useState(false);
      const [playingAudio, setPlayingAudio]     = useState(null);
      const [quranSearch, setQuranSearch]       = useState('');
      const [isPlayingFullSurah, setIsPlayingFullSurah] = useState(false);
      const [currentFullSurahIndex, setCurrentFullSurahIndex] = useState(0);
      const [quranPlayMode, setQuranPlayMode]   = useState('full');
      const [startAyah, setStartAyah]           = useState('');
      const [endAyah, setEndAyah]               = useState('');
      const [isPlayingRange, setIsPlayingRange] = useState(false);
      const [selectedQari, setSelectedQari]     = useState('ar.alafasy');
      const isPlayingFullSurahRef = useRef(false);
      const isPlayingRangeRef     = useRef(false);
      const audioRef              = useRef(null);

      // ── Theme ──
      useEffect(() => {
        document.documentElement.classList.toggle('dark', theme === 'dark');
        ls.setStr('theme', theme);
      }, [theme]);

      // ── Toast ──
      const showToast = useCallback((message, type='success') => {
        setToast({ show:true, message, type });
        setTimeout(() => setToast(p => ({ ...p, show:false })), 4000);
      }, []);

      const askConfirmation = (message, action) =>
        setConfirmModal({ isOpen:true, message, action: () => { action(); setConfirmModal({ isOpen:false, message:'', action:null }); }});

      // ── Cloud Sync ──
      const syncWithCloud = useCallback(async (urlToUse) => {
        const url = urlToUse !== undefined ? urlToUse : apiUrl;
        if (!url) {
          setTodos(ls.get('local_todos', FALLBACK_TODOS));
          setInfos(ls.get('local_infos', FALLBACK_INFOS));
          const lu = ls.get('local_users', null);
          if (lu) setUsers(lu);
          setApiConnected(false);
          return;
        }
        setSyncing(true);
        try {
          // ✅ FIX #5: Tambah no-cors fallback dan timeout untuk handle GAS lambat
          const controller = new AbortController();
          const tid = setTimeout(() => controller.abort(), 10000);
          const [tRes, iRes, uRes] = await Promise.all([
            fetch(`${url}?action=getTodos`, { signal: controller.signal }),
            fetch(`${url}?action=getInfos`, { signal: controller.signal }),
            fetch(`${url}?action=getUsers`, { signal: controller.signal }),
          ]);
          clearTimeout(tid);
          const [tData, iData, uData] = await Promise.all([tRes.json(), iRes.json(), uRes.json()]);
          if (tData.status === 'success') { setTodos(tData.data); ls.set('local_todos', tData.data); setApiConnected(true); }
          if (iData.status === 'success') { setInfos(iData.data); ls.set('local_infos', iData.data); }
          if (uData.status === 'success') { setUsers(uData.data); ls.set('local_users', uData.data); }
        } catch(err) {
          console.warn('Sync gagal, pakai cache lokal:', err.message);
          setTodos(ls.get('local_todos', FALLBACK_TODOS));
          setInfos(ls.get('local_infos', FALLBACK_INFOS));
          const lu = ls.get('local_users', null);
          if (lu) setUsers(lu);
          setApiConnected(false);
        } finally { setSyncing(false); }
      }, [apiUrl]);

      useEffect(() => {
        if (apiUrl) ls.setStr('gas_api_url', apiUrl);
        syncWithCloud(apiUrl);
        loadQuranSurahs();
      }, [apiUrl]);

      // ── Quran ──
      const loadQuranSurahs = async () => {
        setLoadingQuran(true);
        try {
          const res = await fetch('https://api.alquran.cloud/v1/surah');
          const data = await res.json();
          if (data.code === 200) setQuranSurahs(data.data);
        } catch(e) { showToast('Gagal memuat daftar Al-Quran', 'error'); }
        finally { setLoadingQuran(false); }
      };

      const viewSurahDetails = async (surahNumber, qariId = selectedQari) => {
        setLoadingQuran(true);
        isPlayingFullSurahRef.current = false; isPlayingRangeRef.current = false;
        setIsPlayingFullSurah(false); setIsPlayingRange(false);
        setStartAyah(''); setEndAyah('');
        try {
          const res = await fetch(`https://api.alquran.cloud/v1/surah/${surahNumber}/editions/quran-uthmani,id.indonesian,${qariId}`);
          const data = await res.json();
          if (data.code === 200) {
            setSurahDetails({
              info: data.data[0],
              verses: data.data[0].ayahs.map((a, i) => ({
                number: a.numberInSurah,
                text: a.text,
                translation: data.data[1].ayahs[i].text,
                audio: data.data[2].ayahs[i].audio
              }))
            });
            setSelectedSurah(surahNumber);
          }
        } catch(e) { showToast('Gagal memuat ayat Al-Quran.', 'error'); }
        finally { setLoadingQuran(false); }
      };

      const handlePlayAudio = (audioUrl, verseId) => {
        isPlayingFullSurahRef.current = false; isPlayingRangeRef.current = false;
        setIsPlayingFullSurah(false); setIsPlayingRange(false);
        if (audioRef.current) audioRef.current.pause();
        if (playingAudio && playingAudio.id === verseId) { setPlayingAudio(null); return; }
        audioRef.current = new Audio(audioUrl);
        audioRef.current.play().catch(()=>{});
        setPlayingAudio({ url: audioUrl, id: verseId });
        audioRef.current.onended = () => setPlayingAudio(null);
      };

      const playSurahVerse = (index) => {
        if (!isPlayingFullSurahRef.current) return;
        if (index >= surahDetails.verses.length) { playSurahVerse(0); return; }
        const verse = surahDetails.verses[index];
        setCurrentFullSurahIndex(index);
        if (audioRef.current) audioRef.current.pause();
        audioRef.current = new Audio(verse.audio);
        audioRef.current.play().catch(()=>{});
        setPlayingAudio({ url: verse.audio, id: verse.number });
        audioRef.current.onended = () => playSurahVerse(index + 1);
      };

      const handlePlayFullSurah = () => {
        if (!surahDetails) return;
        if (isPlayingFullSurahRef.current) {
          if (audioRef.current) audioRef.current.pause();
          isPlayingFullSurahRef.current = false; setIsPlayingFullSurah(false); setPlayingAudio(null);
        } else {
          isPlayingFullSurahRef.current = true; isPlayingRangeRef.current = false;
          setIsPlayingFullSurah(true); setIsPlayingRange(false);
          playSurahVerse(0);
        }
      };

      const playSurahVerseRange = (currIndex, endIndex) => {
        if (!isPlayingRangeRef.current) return;
        const startVal = parseInt(startAyah, 10) || 1;
        if (currIndex > endIndex || currIndex >= surahDetails.verses.length) { playSurahVerseRange(startVal - 1, endIndex); return; }
        const verse = surahDetails.verses[currIndex];
        setCurrentFullSurahIndex(currIndex);
        if (audioRef.current) audioRef.current.pause();
        audioRef.current = new Audio(verse.audio);
        audioRef.current.play().catch(()=>{});
        setPlayingAudio({ url: verse.audio, id: verse.number });
        audioRef.current.onended = () => playSurahVerseRange(currIndex + 1, endIndex);
      };

      const handleQuranPlayback = () => {
        if (!surahDetails) return;
        if (quranPlayMode === 'full') { handlePlayFullSurah(); return; }
        if (isPlayingRangeRef.current) {
          if (audioRef.current) audioRef.current.pause();
          isPlayingRangeRef.current = false; setIsPlayingRange(false); setPlayingAudio(null);
        } else {
          const sv = parseInt(startAyah, 10);
          const ev = parseInt(endAyah, 10) || surahDetails.info.numberOfAyahs;
          if (isNaN(sv) || sv < 1 || sv > surahDetails.info.numberOfAyahs) { showToast('Nomor ayat awal tidak valid!', 'error'); return; }
          if (isNaN(ev) || ev < sv || ev > surahDetails.info.numberOfAyahs) { showToast('Nomor ayat akhir tidak valid!', 'error'); return; }
          isPlayingRangeRef.current = true; isPlayingFullSurahRef.current = false;
          setIsPlayingRange(true); setIsPlayingFullSurah(false);
          playSurahVerseRange(sv - 1, ev - 1);
        }
      };

      // ── Auth ──
      const handleRegister = async (e) => {
        e.preventDefault(); setAuthError(''); setAuthSuccess('');
        if (regForm.password.length < 3) { setAuthError('Password minimal 3 karakter!'); return; }
        const uL = regForm.username.toLowerCase().trim();
        const eL = regForm.email.toLowerCase().trim();
        if (apiUrl) {
          setSyncing(true);
          try {
            const res = await fetch(apiUrl, { method:'POST', mode:'cors', headers:{'Content-Type':'text/plain'}, body:JSON.stringify({ action:'registerUser', username:uL, email:eL, password:regForm.password }) });
            const data = await res.json();
            if (data.status === 'success') { setAuthSuccess('Registrasi berhasil! Silakan masuk.'); setLoginForm({ username:uL, password:regForm.password }); setIsRegisterMode(false); }
            else setAuthError(data.message || 'Registrasi gagal.');
          } catch(err) { setAuthError('Gagal terhubung ke cloud backend.'); }
          finally { setSyncing(false); }
        } else {
          const curUsers = ls.get('local_users', []);
          if (curUsers.some(u => u.username.toLowerCase()===uL || u.email.toLowerCase()===eL)) { setAuthError('Username atau Email sudah terdaftar!'); return; }
          const newUser = { username:uL, email:eL, password:regForm.password, role: curUsers.length===0 ? 'admin' : 'user' };
          const upd = [...curUsers, newUser]; ls.set('local_users', upd); setUsers(upd);
          setAuthSuccess('Registrasi berhasil! Masuk menggunakan akun Anda.');
          setLoginForm({ username:uL, password:regForm.password }); setIsRegisterMode(false);
        }
      };

      const attemptLocalLogin = (queryStr) => {
        const curUsers = ls.get('local_users', []);
        const m = curUsers.find(u => (u.username.toLowerCase()===queryStr || u.email.toLowerCase()===queryStr) && u.password.toString()===loginForm.password.toString());
        if (m) { const s = { username:m.username, email:m.email, role:m.role }; setCurrentUser(s); ls.set('active_user', s); syncWithCloud(); }
        else setAuthError('Username atau password salah.');
      };

      const handleLogin = async (e) => {
        e.preventDefault(); setAuthError('');
        if (!loginForm.username || !loginForm.password) { setAuthError('Mohon isi username dan password!'); return; }
        const qStr = loginForm.username.toLowerCase().trim();
        if (apiUrl) {
          setSyncing(true);
          try {
            const res = await fetch(`${apiUrl}?action=getUsers`);
            const data = await res.json();
            if (data.status === 'success') {
              const m = data.data.find(u => (u.username.toString().toLowerCase().trim()===qStr || u.email.toString().toLowerCase().trim()===qStr) && u.password.toString()===loginForm.password.toString());
              if (m) { const s = { username:m.username, email:m.email, role:m.role||'user' }; setCurrentUser(s); ls.set('active_user', s); syncWithCloud(); }
              else setAuthError('Username atau password salah / Akun belum disetujui admin.');
            } else setAuthError('Error memverifikasi kredensial.');
          } catch(err) { setAuthError('Backend Cloud tidak merespon. Mencoba login lokal...'); attemptLocalLogin(qStr); }
          finally { setSyncing(false); }
        } else { attemptLocalLogin(qStr); }
      };

      const handleLogout = () => {
        setCurrentUser(null); ls.remove('active_user');
        isPlayingFullSurahRef.current = false; isPlayingRangeRef.current = false;
        setIsPlayingFullSurah(false); setIsPlayingRange(false);
        if (audioRef.current) audioRef.current.pause();
        setPlayingAudio(null);
      };

      // ── Activities (Todos) ──
      const handleSaveActivity = async (e) => {
        e.preventDefault();
        if (currentUser.role !== 'admin') { showToast('Hanya Administrator yang dapat memanipulasi rencana kerja!', 'error'); return; }
        const payload = { action:'saveTodo', id: activityForm.id || Date.now().toString(), task:activityForm.task, subActivity:activityForm.subActivity, pic:activityForm.pic, startDate:formatToInputDate(activityForm.startDate) || todayInputDate(), endDate:formatToInputDate(activityForm.endDate), progress:Number(activityForm.progress), keterangan:activityForm.keterangan||'', createdBy:currentUser.username };
        if (apiUrl) {
          setSyncing(true);
          try {
            const res = await fetch(apiUrl, { method:'POST', mode:'cors', headers:{'Content-Type':'text/plain'}, body:JSON.stringify(payload) });
            const data = await res.json();
            if (data.status === 'success') { setIsModalOpen(false); showToast('Rencana kerja berhasil disimpan!'); syncWithCloud(); }
            else showToast('Gagal menyimpan: ' + data.message, 'error');
          } catch(err) { showToast('Koneksi Cloud gagal. Disimpan lokal.', 'warning'); saveActivityLocally(payload); }
          finally { setSyncing(false); }
        } else { saveActivityLocally(payload); }
      };

